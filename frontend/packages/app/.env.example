VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Authentication provider: "none" | "google" | "shotgrid"
# "shotgrid" is the recommended mode for production deployments.
# Mode (pat vs sso) is auto-detected from the backend SHOTGRID_AUTH_MODE env var.
VITE_AUTH_PROVIDER=shotgrid

# Required only when VITE_AUTH_PROVIDER=google
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
